    "servidor:probar": "node scripts/probar-servidor.mjs",
    "iva:revisar": "tsx scripts/revisar-iva.mts",
    "verificar": "npm run typecheck && npm run lint && npm run test && npm run build"
  },
  "dependencies": {
    "@react-pdf/renderer": "4.9.0",
    "next": "16.3.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sharp": "0.35.4",
    "zod": "4.6.2"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.13",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.13.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.13",
    "typescript": "6.0.3",
    "unpdf": "1.8.1",
    "vitest": "4.1.11"
  }
}
